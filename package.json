{
  "name": "mcp-supabase-selfhosted",
  "version": "1.1.0",
  "description": "An open-source Model Context Protocol (MCP) server designed specifically for self-hosted Supabase instances.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-supabase-selfhosted": "dist/index.js"
  },
  "scripts": {
    "test": "tsx --test tests/tools.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "supabase",
    "self-hosted",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "author": "adiego-101",
  "homepage": "https://github.com/adiego-101/mcp-supabase-selfhosted#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adiego-101/mcp-supabase-selfhosted.git"
  },
  "bugs": {
    "url": "https://github.com/adiego-101/mcp-supabase-selfhosted/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0"
  }
}
